[Unit]
Description=Inventory Plus historical restock evidence capture
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=inventoryplus
WorkingDirectory=/opt/inventory-plus/forecasting_backend
EnvironmentFile=/etc/inventory-plus/forecast.env
Environment=PYTHONUNBUFFERED=1
StateDirectory=inventory-plus
ExecStart=/opt/inventory-plus/forecasting_backend/.venv/bin/python run_restock_evidence_capture.py --capture --location-id 11111111-1111-1111-1111-111111111111 --batch-size 25 --max-pages 1 --interval-seconds 60 --state-file /var/lib/inventory-plus/restock-evidence-capture.json
Restart=on-failure
RestartSec=60
TimeoutStopSec=120
MemoryMax=512M
CPUQuota=25%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
